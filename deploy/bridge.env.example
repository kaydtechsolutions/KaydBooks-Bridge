# Paths and URLs only. Put secrets in /etc/kaydbooks/credentials.json (mode 0600).
KAYDBOOKS_CONFIG=/etc/kaydbooks/bridge-config.json
KAYDBOOKS_QBWC_SECRET_FILE=/etc/kaydbooks/credentials.json
KAYDBOOKS_QBWC_ENDPOINT=https://kaydbooks-server.REPLACE_TAILNET.ts.net/qbwc
KAYDBOOKS_QBWC_HOST=127.0.0.1
KAYDBOOKS_QBWC_PORT=8080
KAYDBOOKS_QBWC_BEHIND_PROXY=1
KAYDBOOKS_REMOTE_SECRET_FILE=/etc/kaydbooks/credentials.json
KAYDBOOKS_REMOTE_POLICY=/etc/kaydbooks/remote-policy.json
KAYDBOOKS_BASE_URL=https://kaydbooks-server.REPLACE_TAILNET.ts.net
KAYDBOOKS_REMOTE_HOST=127.0.0.1
KAYDBOOKS_REMOTE_PORT=8000
KAYDBOOKS_COMPOSIO_POLICY=/etc/kaydbooks/composio-policy.json
