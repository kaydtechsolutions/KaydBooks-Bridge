{
	auto_https off
	admin off
}

http://:8088 {
	bind 127.0.0.1
	log {
		output file /var/log/caddy/kaydbooks-access.log {
			roll_size 25MiB
			roll_keep 10
		}
		format json
	}

	@mcp path /mcp /mcp/* /health
	handle @mcp {
		reverse_proxy 127.0.0.1:8000
	}

	@bridge path /qbwc /qbwc/* /setup /setup/* /admin /admin/* /app /app/* /api/* /support /healthz
	handle @bridge {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "" 404
	}
}

# Proxmox maps an LXC's own hostname to 127.0.1.1. The outbound OpenAI tunnel
# uses this loopback-only listener so the upstream receives the canonical Host
# value without a port suffix.
http://:80 {
	bind 127.0.1.1

	@mcp path /mcp /mcp/* /health
	handle @mcp {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "" 404
	}
}
