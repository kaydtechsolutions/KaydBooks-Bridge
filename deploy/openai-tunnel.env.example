# Copy to /etc/kaydbooks/openai-tunnel.env with root:root ownership and mode 0600.
# Systemd loads this file; the isolated tunnel account cannot read this directory.
# Create this runtime-only key in the OpenAI Platform tunnel settings. Never commit it.
CONTROL_PLANE_API_KEY=replace-with-runtime-key
CONTROL_PLANE_TUNNEL_ID=replace-with-tunnel-id
